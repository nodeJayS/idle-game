{
  "name": "idle-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Cute-pixel-art idle ARPG (Diablo/PoE-style loot, Minecraft-friendly surface).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
