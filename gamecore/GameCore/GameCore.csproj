<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 for `dotnet test`. The source is written C# 9-compatible so the
         same .cs files drop into Unity (which compiles them with its own runtime). -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>IdleGame.GameCore</RootNamespace>
    <AssemblyName>IdleGame.GameCore</AssemblyName>
  </PropertyGroup>

</Project>
