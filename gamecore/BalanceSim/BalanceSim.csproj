<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>IdleGame.BalanceSim</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same single-source-of-truth pattern as GameCore.Tests: compile the SAME
         GameCore sources Unity uses. The sim is a pure-C# console client. -->
    <Compile Include="..\..\unity\Assets\GameCore\**\*.cs" />
  </ItemGroup>

</Project>
